{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://drevo-archive.tail80303a.ts.net/api/:path*" },
    { "source": "/ai/images/:path*", "destination": "https://drevo-archive.tail80303a.ts.net/ai/images/:path*" },
    { "source": "/ai/crops/:path*", "destination": "https://drevo-archive.tail80303a.ts.net/ai/crops/:path*" },
    { "source": "/health", "destination": "https://drevo-archive.tail80303a.ts.net/health" }
  ],
  "headers": [
    {
      "source": "/(api|ai)/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
